WITH
aggd1 AS (
 FIND emp e, e VIA same_owner pet p
 FETCH DISTINCT e.empno i1, p.species k1, e.sal c1),
aggm1 AS (FIND aggd1 x FETCH x.k1 k1, count() v1, sum(x.c1) v2),
aggd2 AS (
 FIND emp e, e VIA same_owner pet p
 FETCH DISTINCT p.pname i1, p.species k1, p.age c1),
aggm2 AS (FIND aggd2 x FETCH x.k1 k1, count() v3, sum(x.c1) v4),
aggu AS (FIND aggm1 a FETCH a.k1 k1, a.v1 v1, a.v2 v2, to_integer(NULL) v3, to_integer(NULL) v4
 UNIONALL
 FIND aggm2 a FETCH a.k1 k1, to_integer(NULL) v1, to_decimal(NULL, 18, 4) v2, a.v3 v3, a.v4 v4)
FIND aggu t
 FETCH t.k1 species ASC, max(t.v1) owners, max(t.v2) ownerssal, max(t.v3) pets, max(t.v4) sumage