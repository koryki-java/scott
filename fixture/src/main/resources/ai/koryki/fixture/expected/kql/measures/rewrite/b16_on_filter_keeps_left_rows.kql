WITH
aggd1 AS (
 FIND dept d, d VIA same_department + emp e
 FILTER e.job = 'CLERK'
 FETCH DISTINCT d.deptno i1),
aggm1 AS (FIND aggd1 x FETCH count(x.i1) v1),
aggd2 AS (
 FIND dept d, d VIA same_department + emp e
 FILTER e.job = 'CLERK'
 FETCH DISTINCT e.empno i1, e.sal c1),
aggm2 AS (FIND aggd2 x FETCH count(x.i1) v2, sum(x.c1) v3),
aggu AS (FIND aggm1 a FETCH a.v1 v1, to_integer(NULL) v2, to_decimal(NULL, 18, 4) v3
 UNIONALL
 FIND aggm2 a FETCH to_integer(NULL) v1, a.v2 v2, a.v3 v3)
FIND aggu t
 FETCH max(t.v1) deptcount, max(t.v2) empcount, max(t.v3) sumsal, to_double(max(t.v3)) / max(t.v1) salperdept