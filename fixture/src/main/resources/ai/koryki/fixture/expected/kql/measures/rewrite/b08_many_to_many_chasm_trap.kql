WITH
aggd1 AS (
 FIND emp e, e VIA same_department dept d, d VIA same_department emp c
 FETCH DISTINCT e.empno i1, e.deptno k1, e.sal c1),
aggm1 AS (FIND aggd1 x FETCH x.k1 k1, sum(x.c1) v1),
aggd2 AS (
 FIND emp e, e VIA same_department dept d, d VIA same_department emp c
 FETCH DISTINCT c.empno i1, e.deptno k1),
aggm2 AS (FIND aggd2 x FETCH x.k1 k1, count() v2),
aggu AS (FIND aggm1 a FETCH a.k1 k1, a.v1 v1, to_integer(NULL) v2
 UNIONALL
 FIND aggm2 a FETCH a.k1 k1, to_decimal(NULL, 18, 4) v1, a.v2 v2)
FIND aggu t
 FETCH t.k1 deptno ASC, max(t.v1) sumsal, max(t.v2) colleagues